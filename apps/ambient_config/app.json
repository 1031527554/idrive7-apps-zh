{
  "id": "ambient_config",
  "title": "Ambient config",
  "description": "Any colour on the ambient light, animations, and a look for each driving mode",
  "version": "2.0.4",
  "vendor": "custom",
  "loggingId": "OAA4",
  "iconGlyph": "ambient",
  "autostart": true,
  "signals": {
    "de.bmw.infotainment.misc.ComfortFunctionIuK": {
      "ambientLightInteriorColour": "w",
      "statusAmbientLightInteriorColour": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "the driving mode: colours by mode",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "_optional": "the revs: the Follow driving animation",
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_optional": "the speed: the Follow driving animation",
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "_optional": "g, along and sideways: the Follow driving animation",
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "_optional": "day or night: dimmer at night",
      "statusDayNightChangeOver": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Ambient config",
      "buttons": [
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "carKind",
      "label": "Car type",
      "type": "choice",
      "default": "ice",
      "hidden": true,
      "options": [
        [
          "ice",
          "Petrol or diesel"
        ],
        [
          "hybrid",
          "Plug-in hybrid"
        ]
      ]
    },
    {
      "key": "follow",
      "label": "Look by driving mode",
      "type": "bool",
      "default": true,
      "hidden": true
    },
    {
      "key": "welcome",
      "label": "Welcome sweep at start",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "sportPulse",
      "label": "Sport pulse",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "nightDim",
      "label": "Dimmer at night",
      "type": "bool",
      "default": true
    },
    {
      "key": "keep",
      "label": "My colour back at each start",
      "type": "bool",
      "default": true
    },
    {
      "key": "flashAlerts",
      "label": "Redline shift flash",
      "type": "bool",
      "default": true,
      "hidden": true
    },
    {
      "key": "drive",
      "label": "Steering wheel",
      "type": "choice",
      "default": "lhd",
      "options": [
        [
          "lhd",
          "Left"
        ],
        [
          "rhd",
          "Right"
        ]
      ]
    },
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Auto"
        ],
        [
          "on",
          "Always"
        ],
        [
          "off",
          "Never"
        ]
      ]
    }
  ]
}
